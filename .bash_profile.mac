# function parse_git_branch {
#   ref=$(git symbolic-ref HEAD 2> /dev/null) || return
#   # Check if there are changes pending commit
#   if ! git diff --quiet || ! git diff --cached --quiet; then
#     color=208 # orange for pending changes
#   # Check if the branch is ahead or behind its upstream
#   elif [ "$(git rev-list --count HEAD...@{u})" -ne 0 ]; then
#     color=208 # orange if the local branch is ahead or behind
#   else
#     color=6 # cyan if everything is up-to-date
#   fi
#   echo " $(tput setaf $color)(${ref#refs/heads/})$(tput sgr0) "
# }
function parse_git_branch {
  ref=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || return

  local color=6   # default cyan

  # 1 – unstaged / staged changes → orange
  if ! git diff --quiet || ! git diff --cached --quiet; then
    color=208

  # 2 – ahead/behind of upstream → orange
  elif git rev-parse --quiet --verify @{u} >/dev/null 2>&1; then
    local ahead_behind
    ahead_behind=$(git rev-list --left-right --count @{u}...HEAD | awk '{print $1 + $2}')
    if [ "$ahead_behind" -ne 0 ]; then
      color=208
    fi
  fi

  echo " $(tput setaf $color)(${ref})$(tput sgr0) "
}

# Bash History Configuration
export HISTTIMEFORMAT="%F %T "
export HISTSIZE=1000000
export HISTFILESIZE=100000000

# Append to history file instead of overwriting (prevents history loss)
shopt -s histappend

# Write history after each command and reload from file (syncs across terminals)
PROMPT_COMMAND="history -a; history -n"
export PROMPT_HOSTNAME=$(hostname | cut -f-2 -d.)
export PS1="\[$(tput bold)\][\[$(tput setaf 4)\]\d\[$(tput setaf 7)\] \[$(tput setaf 2)\]\t\[$(tput setaf 7)\]][\[$(tput setaf 1)\]\u\[$(tput setaf 7)\]@\[$(tput setaf 3)\]$PROMPT_HOSTNAME\[$(tput setaf 7)\]] \[$(tput setaf 7)\]\w\[$(tput setaf 7)\]\$(parse_git_branch)\n➤ \[$(tput sgr0)\]"
export PATH=${PATH}:~/bin:/usr/local/bin:/usr/local/sbin:/usr/bin/git:/opt/homebrew/opt/mysql-client@8.0/bin:
export PS_FORMAT=user:20,pid,pcpu,pmem,vsz,rss,tname,stat,start_time,bsdtime,args
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8
export BASH_SILENCE_DEPRECATION_WARNING=1
export COPYFILE_DISABLE=1

# Load comet-support-agent local credentials (MCP tokens, API keys)
COMET_ENV_LOCAL="/Users/darenj/Documents/Github/comet-support-agent/.env.local"
if [ -f "$COMET_ENV_LOCAL" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$COMET_ENV_LOCAL"
  set +a
fi
unset COMET_ENV_LOCAL

neofetch

# ATUIN
export ATUIN_NOBIND="true"
eval "$(atuin init bash)"

# bind to ctrl-r, add any other bindings you want here too
bind -x '"\C-r": __atuin_history'

# Added by comet-support-agent troubleshooting
export PATH="/opt/homebrew/bin:$PATH"

# Compatibility aliases
alias awscli='aws'
alias neofetch='fastfetch'
